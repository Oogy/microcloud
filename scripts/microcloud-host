#!/usr/bin/env bash
set -euo pipefail

is_raspberry_pi() {
  if [[ -r /proc/device-tree/model ]]; then
    local model
    model="$(tr -d '\0' </proc/device-tree/model)"
    [[ "${model}" == *"Raspberry Pi"* ]]
    return $?
  fi
  return 1
}

get_dmi_serial() {
  if [[ -r /sys/class/dmi/id/product_serial ]]; then
    tr -d '\0' </sys/class/dmi/id/product_serial
    return 0
  fi
  if command -v dmidecode >/dev/null 2>&1; then
    dmidecode -s system-serial-number 2>/dev/null | head -n 1
    return 0
  fi
  return 1
}

get_pi_serial() {
  if [[ -r /proc/device-tree/serial-number ]]; then
    tr -d '\0' </proc/device-tree/serial-number
    return 0
  fi
  if [[ -r /proc/cpuinfo ]]; then
    awk -F': ' '/^Serial/ {print $2; exit}' /proc/cpuinfo
    return 0
  fi
  return 1
}

get_device_serial() {
  local serial=""
  if is_raspberry_pi; then
    serial="$(get_pi_serial || true)"
  else
    serial="$(get_dmi_serial || true)"
  fi

  serial="$(echo "${serial}" | tr -d '[:space:]')"
  if [[ -z "${serial}" || "${serial}" == "None" || "${serial}" == "Unknown" ]]; then
    echo "error: unable to determine device serial" >&2
    exit 1
  fi

  echo "${serial}"
}

read_host_file() {
  local serial="$1"
  echo "/usr/local/share/microcloud/hosts/${serial}.yaml"
}

read_hostname_from_host_file() {
  local host_file="$1"
  awk -F': *' '/^hostname:/{print $2; exit}' "${host_file}" | tr -d '"'
}

set_hostname() {
  local target="$1"
  if [[ -z "${target}" ]]; then
    return 0
  fi

  if [[ "$(hostname)" == "${target}" ]]; then
    return 0
  fi

  hostnamectl set-hostname "${target}"
  echo "${target}" >/etc/hostname
}

read_cmdline() {
  cat /boot/firmware/cmdline.txt
}

cmdline_has_token() {
  local token="$1"
  local cmdline="$2"
  grep -qw "${token}" <<<"${cmdline}"
}

enable_cgroup_memory() {
  local cmdline
  cmdline="$(read_cmdline)"

  if ! cmdline_has_token "cgroup_enable=memory" "${cmdline}"; then
    cmdline="${cmdline} cgroup_enable=memory"
  fi
  if ! cmdline_has_token "cgroup_memory=1" "${cmdline}"; then
    cmdline="${cmdline} cgroup_memory=1"
  fi

  echo "${cmdline}" > /boot/firmware/cmdline.txt
}

mark_complete() {
  mkdir -p /var/lib/microcloud
  touch /var/lib/microcloud/host.done
  systemctl daemon-reload
  systemctl enable --now microcloud-host.target
}

main() {
  if [[ -f /var/lib/microcloud/host.done ]]; then
    exit 0
  fi

  local serial
  local host_file
  local hostname_target

  serial="$(get_device_serial)"
  host_file="$(read_host_file "${serial}")"
  if [[ -r "${host_file}" ]]; then
    hostname_target="$(read_hostname_from_host_file "${host_file}")"
  else
    hostname_target=""
  fi

  if ! is_raspberry_pi; then
    set_hostname "${hostname_target}"
    mark_complete
    exit 0
  fi

  if [[ ! -r /boot/firmware/cmdline.txt ]]; then
    echo "error: /boot/firmware/cmdline.txt not readable" >&2
    exit 1
  fi

  local cmdline
  cmdline="$(read_cmdline)"

  if cmdline_has_token "cgroup_enable=memory" "${cmdline}" && cmdline_has_token "cgroup_memory=1" "${cmdline}"; then
    set_hostname "${hostname_target}"
    mark_complete
    exit 0
  fi

  enable_cgroup_memory
  systemctl reboot
}

main "$@"
